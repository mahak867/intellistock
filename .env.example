# ─────────────────────────────────────────────────────────────────────────────
# IntelliStock — Environment Variables
# Copy this to .env and fill in all values marked REQUIRED
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=IntelliStock
APP_VERSION=1.0.0
# development | staging | production
ENVIRONMENT=development
# synthetic (placeholders) | nse (files from scripts/fetch_data.py, personal research) | local (licensed vendor data)
DATA_PROVIDER=synthetic
# true only if you hold an NSE Data & Analytics agreement (see LICENSING.md)
NSE_DATA_LICENSED=false
DATA_DIR=./data
DEBUG=true
LOG_LEVEL=INFO

# ── Security (REQUIRED) ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_secret_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for dev only)
ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Database (PostgreSQL) (REQUIRED) ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://intellistock:CHANGE_ME_DB_PASSWORD@localhost:5432/intellistock
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# Docker Compose variable (separate from DATABASE_URL)
POSTGRES_USER=intellistock
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Redis (REQUIRED) ───────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CACHE_TTL_SECONDS=300
PREDICTION_CACHE_TTL=900

# ── ML Model ───────────────────────────────────────────────────────────────────
# local | s3 | gcs | azure
MODEL_STORE=local
MODEL_BUCKET=intellistock-models
MODEL_VERSION=v1
SEQUENCE_LENGTH=60
PREDICTION_HORIZON=5
RETRAIN_INTERVAL_HOURS=24

# ── Alerts ─────────────────────────────────────────────────────────────────────
# How often the worker checks alert rules. Prices are end-of-day, so a check never sees a live price.
ALERT_CHECK_MINUTES=30
# Optional. Create a bot with @BotFather and paste its token to send alerts to Telegram.
TELEGRAM_BOT_TOKEN=

# ── Broker (Zerodha Kite Connect) ──────────────────────────────────────────────
# Each user enters their own Kite Connect API key and secret in the app. This key encrypts them at rest
# (any long random string; defaults to one derived from SECRET_KEY).
BROKER_ENCRYPTION_KEY=
# false = holdings and live prices only, no order placement
BROKER_ORDERS_ENABLED=true

# ── AWS (if MODEL_STORE=s3) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── GCP (if MODEL_STORE=gcs) ──────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# ── Azure (if MODEL_STORE=azure) ───────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=

# ── Monitoring ─────────────────────────────────────────────────────────────────
# get from sentry.io (leave empty to disable)
SENTRY_DSN=
PROMETHEUS_ENABLED=true
# e.g. http://jaeger:4317
OTEL_EXPORTER_ENDPOINT=

# ── Market Data ────────────────────────────────────────────────────────────────
DEFAULT_EXCHANGE=NSE
DEFAULT_CURRENCY=INR
MARKET_DATA_LOOKBACK_YEARS=5
YFINANCE_TIMEOUT=30

# ── Dashboard ──────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
